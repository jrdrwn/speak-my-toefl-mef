# ============================================================
# Environment Variables — Copy & fill in Vercel Dashboard
# Project Settings → Environment Variables
# ============================================================

# PostgreSQL connection string
# Recommended: Neon (https://neon.tech) — free tier, native Vercel integration
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/toefldb?sslmode=require"

# JWT secret — generate a strong random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"

# Frontend URL (for CORS) — set to your Vercel deployment URL
# e.g. https://speak-my-toefl.vercel.app
# Leave blank if same-domain (Vercel handles this automatically)
FRONTEND_URL=""

# ============================================================
# LOCAL DEV ONLY — do NOT set VITE_API_URL in Vercel dashboard
# (In production, frontend & API are on the same domain)
# ============================================================
# VITE_API_URL=http://localhost:3001
